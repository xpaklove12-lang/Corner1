  _introMessage: "\uC740\uC7AC\uB294 \uC11D \uB2EC\uC9F8 \uB9D0\uC744 \uD558\uC9C0
    \uC54A\uC558\uB2E4. \uB208\uC744 \uB4E4\uC5EC\uB2E4\uBCF4\uBA74 \uB9C8\uC74C\uC18D\uC73C\uB85C
    \uB4E4\uC5B4\uAC08 \uC218 \uC788\uB2E4."
  _idleSituation: "\uC740\uC7AC\uAC00 \uC870\uC6A9\uD788 \uB098\uB97C \uBC14\uB77C\uBCF4\uACE0
    \uC788\uB2E4."
  _abyssMessage: "\uADF8\uB140\uC758 \uB9C8\uC74C \uC18D \uC2EC\uC5F0\uC5D0 \uB4E4\uC5B4\uC654\uB2E4.\n\uAC00\uC7A5
    \uAE4A\uC740 \uACF3\uC5D0\uC11C \uBB34\uC5B8\uAC00\uAC00 \uBC18\uC9DD\uC778\uB2E4."
  _entryLine: 
  _endings:
  - _id: truth
    _title: "\uC5D4\uB529 \xB7 47\uCD08"
    _situation: "\uC740\uC7AC\uC758 \uB9C8\uC74C\uC774 \uB4E4\uB9B0\uB2E4."
    _lines:
    - "\uADF8\uB140\uC758 \uB9C8\uC74C \uC18D \uC2EC\uC5F0\uC5D0 \uB4E4\uC5B4\uC654\uB2E4.
      \uC740\uC7AC\uC758 \uB9C8\uC74C\uC774 \uB4E4\uB824\uC654\uB2E4."
    - "'\uB2E4\uB4E4 \uB0B4\uAC00 \uC804\uD654\uB97C \uBABB \uBC1B\uC740 \uC904 \uC54C\uC544.'"
    - "'\uC544\uB2C8\uC57C. \uB300\uAE30\uC2E4\uC5D0\uC11C \uC544\uBE60 \uC774\uB984\uC744
      \uBCF4\uACE0\u2026 \uB0B4\uAC00 \uAC70\uC808\uC744 \uB20C\uB800\uC5B4.'"
    - "'\uC544\uBE60\uB294 \uADF8\uB54C \uB85C\uBE44\uC5D0 \uC788\uC5C8\uB300. \uB0B4
      \uC5F0\uC8FC\uB97C \uB4E4\uC73C\uB7EC, \uBAB0\uB798.'"
    - "'\uBA54\uC2DC\uC9C0\uB97C \uB4E4\uC73C\uBA74 \uADF8\uAC8C \uC9C4\uC9DC \uB9C8\uC9C0\uB9C9\uC774
      \uB418\uC796\uC544.'"
    - "\uC740\uC7AC\uAC00 \uD734\uB300\uD3F0\uC744 \uB4A4\uC9D1\uC5C8\uB2E4. \uADF8\uB9AC\uACE0
      \uB0B4 \uCABD\uC73C\uB85C \uCC9C\uCC9C\uD788 \uBC00\uC5C8\uB2E4."
    - "\"\u2026\uAC19\uC774 \uB4E4\uC5B4 \uC904\uB798\uC694?\" \uC11D \uB2EC \uB9CC\uC758
      \uCCAB\uB9C8\uB514\uC600\uB2E4."
    - "\u2014 \uC740\uC7AC\uC57C, \uC544\uBE60 \uC654\uC5B4. \uB9E8 \uB4A4\uC5D0
      \uC549\uC544 \uC788\uC744\uAC8C. \uB5A8\uC9C0 \uB9C8. \uD2C0\uB824\uB3C4 \uB3FC.
      \u2014"
    - "\uC740\uC7AC\uB294 \uC624\uB798 \uC6B8\uC5C8\uB2E4. \uADF8\uB9AC\uACE0 \uADF8\uB0A0
      \uCC98\uC74C\uC73C\uB85C, \uD53C\uC544\uB178 \uB69C\uAED1\uC744 \uC5F4\uC5C8\uB2E4."
    _afterLine: "\"\u2026\uB2E4\uC74C \uC8FC\uC5D0\uB3C4 \uC62C\uAC8C\uC694. \uADF8
      \uACE1, \uC544\uBE60\uD55C\uD14C \uB05D\uAE4C\uC9C0 \uB4E4\uB824\uC8FC\uACE0
      \uC2F6\uC5B4\uC694.\""
  - _id: half
    _title: "\uC5D4\uB529 \xB7 \uBC18\uCABD\uC9DC\uB9AC \uC9C4\uC2EC"
    _situation: "\uB9C8\uC74C\uC758 \uC18C\uB9AC\uAC00 \uBA40\uB2E4."
    _lines:
    - "\uADF8\uB140\uC758 \uB9C8\uC74C \uC18D \uC2EC\uC5F0\uC5D0 \uB4E4\uC5B4\uC654\uB2E4.
      \uBB34\uC5B8\uAC00 \uB4E4\uB9B4 \uB4EF\uD558\uB2E4\uAC00, \uBA40\uC5B4\uC84C\uB2E4."
    - "'\u2026\uBABB \uBC1B\uC558\uC5B4. \uADF8\uB798, \uBABB \uBC1B\uC740 \uAC70\uC57C.'"
    - "\uB9C8\uC74C\uC758 \uC18C\uB9AC\uB294 \uAC70\uAE30\uC11C \uB04A\uACBC\uB2E4.
      \uC740\uC7AC\uB294 \uC544\uC9C1 \uB098\uB97C \uB2E4 \uBBFF\uC9C0 \uC54A\uB294\uB2E4."
    - "\"\u2026\uB124. \uC774\uC81C \uAD1C\uCC2E\uC544\uC694.\" \uC740\uC7AC\uAC00
      \uCC98\uC74C\uC73C\uB85C \uB9D0\uD588\uB2E4. \uC6C3\uACE0 \uC788\uC5C8\uB2E4."
    - "\uADF8 \uC6C3\uC74C\uC774 \uAC70\uC9D3\uC774\uB77C\uB294 \uAC78, \uB098\uB9CC
      \uC54C\uC558\uB2E4. \uD734\uB300\uD3F0\uC740 \uC5EC\uC804\uD788 \uB4A4\uC9D1\uD600
      \uC788\uC5C8\uB2E4."
    _afterLine: "\"\uAD1C\uCC2E\uC544\uC694. \uC815\uB9D0 \uAD1C\uCC2E\uC544\uC694.\"
      (\uAD1C\uCC2E\uC544 \uBCF4\uC774\uC9C0 \uC54A\uB294\uB2E4.)"
  - _id: leave
    _title: "\uC5D4\uB529 \xB7 \uB2EB\uD78C \uB69C\uAED1"
    _situation: "\uC740\uC7AC\uAC00 \uC790\uB9AC\uC5D0\uC11C \uC77C\uC5B4\uB0AC\uB2E4."
    _lines:
    - "\uC740\uC7AC\uAC00 \uC790\uB9AC\uC5D0\uC11C \uC77C\uC5B4\uB0AC\uB2E4."
    - "\uAC00\uBC29\uC744 \uCC59\uAE30\uB294 \uC190\uC740 \uB5A8\uB9AC\uC9C0 \uC54A\uC558\uB2E4.
      \uC774\uBBF8 \uB9C8\uC74C\uC744 \uC815\uD55C \uC190\uC774\uC5C8\uB2E4."
    - "\uBB38\uC774 \uB2EB\uD614\uB2E4. \uC740\uC7AC\uB294 \uADF8 \uB4A4\uB85C \uC0C1\uB2F4\uC2E4\uC5D0
      \uC624\uC9C0 \uC54A\uC558\uB2E4."
    _afterLine: "\uBE48 \uC758\uC790\uB2E4. \uCC3D\uBC16 \uD48D\uACBD\uB9CC \uADF8\uB300\uB85C\uB2E4."
  - _id: delete
    _title: "\uC5D4\uB529 \xB7 \uC0AD\uC81C"
    _situation: "\uC740\uC7AC\uC758 \uB208\uC774 \uCC28\uAC11\uAC8C \uC2DD\uC5C8\uB2E4."
    _lines:
    - "\"\u2026\uB2F9\uC2E0\uC774 \uBB58 \uC54C\uC544\uC694.\" \uC11D \uB2EC \uB9CC\uC758
      \uCCAB\uB9C8\uB514\uB294 \uADF8\uAC70\uC600\uB2E4."
    - "\uC740\uC7AC\uAC00 \uD734\uB300\uD3F0\uC744 \uB4A4\uC9D1\uC5C8\uB2E4. \uC190\uAC00\uB77D\uC774
      \uBE60\uB974\uAC8C \uC6C0\uC9C1\uC600\uB2E4."
    - "[ \uC74C\uC131 \uBA54\uC2DC\uC9C0 1\uAC74\uC744 \uC0AD\uC81C\uD588\uC2B5\uB2C8\uB2E4
      ]"
    - "\uC740\uC7AC\uB294 \uB05D\uB0B4 \uC544\uBB34\uAC83\uB3C4 \uB4E3\uC9C0 \uC54A\uC740
      \uCC44, \uADF8 \uBAA9\uC18C\uB9AC\uB97C \uC9C0\uC6E0\uB2E4."
    _afterLine: "\"\u2026\" \uC740\uC7AC\uB294 \uB05D\uAE4C\uC9C0 \uB098\uB97C \uBCF4\uC9C0
      \uC54A\uC558\uB2E4."
  _truthTrust: 3
  _keyFragment: {fileID: 2097229964}
  _leaveTrust: -2
