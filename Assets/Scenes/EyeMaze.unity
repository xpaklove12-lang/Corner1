  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EyeMaze.DialogueNode
  _situation: "\uC740\uC7AC\uAC00 \uCC3D\uBC16\uB9CC \uBCF4\uACE0 \uC788\uB2E4. \uC11D
    \uB2EC\uC9F8 \uD55C\uB9C8\uB514\uB3C4 \uD558\uC9C0 \uC54A\uC558\uB2E4\uACE0 \uD55C\uB2E4.
    \uBB34\uB98E \uC704 \uC190\uAC00\uB77D\uB9CC \uC26C\uC9C0 \uC54A\uACE0 \uC6C0\uC9C1\uC778\uB2E4."
  _options:
  - _text: "\uC624\uB298\uC740 \uC880 \uC5B4\uB5A0\uC138\uC694?"
    _response: "\uB300\uB2F5\uC774 \uC5C6\uB2E4. \uADF8 \uC9C8\uBB38\uC740 \uC774\uBBF8
      \uBC31 \uBC88\uCBE4 \uB4E4\uC740 \uC5BC\uAD74\uC774\uB2E4."
    _requires: {fileID: 0}
    _requiresClue: {fileID: 0}
    _trust: -1
    _dilation: 0
    _advance: 0
    _ending: 
  - _text: "\uC190\uAC00\uB77D\uC740\u2026 \uC544\uC9C1 \uADF8 \uACE1\uC744 \uAE30\uC5B5\uD558\uACE0
      \uC788\uB098 \uBD10\uC694."
    _response: "\uC190\uAC00\uB77D\uC774 \uBA48\uCDC4\uB2E4. \uCC98\uC74C\uC73C\uB85C
      \uC740\uC7AC\uAC00 \uB098\uB97C \uB611\uBC14\uB85C \uBD24\uB2E4."
    _requires: {fileID: 1941098039}
    _requiresClue: {fileID: 0}
    _trust: 1
    _dilation: 0.15
    _advance: 1
    _ending: 
  - _text: "\uB9D0 \uC548 \uD574\uB3C4 \uB3FC\uC694. \uADF8\uB0E5 \uAC19\uC774 \uC549\uC544
      \uC788\uC744\uAC8C\uC694."
    _response: "\uC5B4\uAE68\uC5D0\uC11C \uD798\uC774 \uC870\uAE08 \uBE60\uC84C\uB2E4."
    _requires: {fileID: 0}
    _requiresClue: {fileID: 0}
    _trust: 0
    _dilation: 0
    _advance: 0
    _ending: 
