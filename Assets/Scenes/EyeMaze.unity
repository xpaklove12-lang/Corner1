--- !u!114 &1329182581
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1329182579}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9358239990ec3d54c969bc30e9ed47d0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EyeMaze.ClientCase
  _order: 1
  _personName: "\uC9C0\uC218"
  _pronoun: "\uADF8\uB140"
  _npc: {fileID: 347521245}
  _dialogue: {fileID: 1940857934}
  _fragmentGroups:
  - {fileID: 576662002}
  - {fileID: 994507320}
  - {fileID: 490263068}
  _mazeSeed: 7319
  _introMessage: "\uC9C0\uC218\uB294 \uACC4\uC18D \uC6C3\uACE0 \uC788\uB2E4. \uD558\uC9C0\uB9CC
    \uB208\uC740 \uC6C3\uC9C0 \uC54A\uB294\uB2E4. \uB9D0\uACFC \uB208 \uC18D \uD30C\uD3B8\uC774
    \uB2E4\uB974\uBA74, \uADF8\uAC78 \uC9DA\uC5B4\uC57C \uD55C\uB2E4."
  _idleSituation: "\uC9C0\uC218\uAC00 \uC6C3\uB294 \uC5BC\uAD74\uB85C \uB098\uB97C
    \uBCF4\uACE0 \uC788\uB2E4."
  _abyssMessage: "\uADF8\uB140\uC758 \uB9C8\uC74C \uC18D \uC2EC\uC5F0\uC5D0 \uB4E4\uC5B4\uC654\uB2E4.\n\uAC00\uC7A5
    \uAE4A\uC740 \uACF3\uC5D0\uC11C \uBB34\uC5B8\uAC00\uAC00 \uBC18\uC9DD\uC778\uB2E4."
  _entryLine: "\"\uC548\uB155\uD558\uC138\uC694! \uD68C\uC0AC\uC5D0\uC11C \uD55C\uBC88
    \uBC1B\uC544 \uBCF4\uB77C\uACE0 \uD574\uC11C\uC694. \uC800\uB294 \uC9C4\uC9DC
    \uAD1C\uCC2E\uC740\uB370, \uD558\uD558.\""
  _endings:
  - _id: truth
    _title: "\uC5D4\uB529 \xB7 \uC548 \uAD1C\uCC2E\uC544\uC694"
    _situation: "\uC9C0\uC218\uC758 \uB9C8\uC74C\uC774 \uB4E4\uB9B0\uB2E4."
    _lines:
    - "\uADF8\uB140\uC758 \uB9C8\uC74C \uC18D \uC2EC\uC5F0\uC5D0 \uB4E4\uC5B4\uC654\uB2E4.
      \uC9C0\uC218\uC758 \uB9C8\uC74C\uC774 \uB4E4\uB824\uC654\uB2E4."
    - "'\uAD1C\uCC2E\uB2E4\uACE0 \uD574\uC57C \uB2E4\uB4E4 \uC548\uC2EC\uD558\uC796\uC544.'"
    - "'\uD300\uC7A5\uB3C4, \uC5C4\uB9C8\uB3C4. \uB0B4\uAC00 \uAD1C\uCC2E\uC73C\uBA74
      \uB2E4 \uAD1C\uCC2E\uC740 \uAC70\uC57C.'"
    - "'\uC4F0\uB7EC\uC84C\uC744 \uB54C \uC81C\uC77C \uBA3C\uC800 \uB4E0 \uC0DD\uAC01\uC774
      \uBB54\uC9C0 \uC54C\uC544? \uB0B4\uC77C \uBCF4\uACE0\uC11C.'"
    - "'\u2026\uB0B4\uAC00 \uBB34\uB108\uC9C0\uBA74, \uC5C4\uB9C8 \uBCD1\uC6D0\uBE44\uB3C4
      \uBB34\uB108\uC838.'"
    - "\uC9C0\uC218\uC758 \uBBF8\uC18C\uAC00 \uCC98\uC74C\uC73C\uB85C \uC0AC\uB77C\uC84C\uB2E4."
    - "\"\u2026\uC0AC\uC2E4, \uD558\uB098\uB3C4 \uC548 \uAD1C\uCC2E\uC544\uC694.\""
    - "\uADF8\uB140\uB294 \uADF8\uB0A0 \uCC98\uC74C\uC73C\uB85C, \uC6C3\uC9C0 \uC54A\uACE0
      \uC6B8\uC5C8\uB2E4."
    _afterLine: "\"\uC5C4\uB9C8\uD55C\uD14C \uB9D0\uD588\uC5B4\uC694. \uC4F0\uB7EC\uC9C4
      \uAC70. \u2026\uAC19\uC774 \uBC29\uBC95\uC744 \uCC3E\uC544\uBCF4\uC790\uACE0
      \uD558\uC2DC\uB354\uB77C\uACE0\uC694.\""
  - _id: half
    _title: "\uC5D4\uB529 \xB7 \uC5F0\uC2B5\uD55C \uBBF8\uC18C"
    _situation: "\uB9C8\uC74C\uC758 \uC18C\uB9AC\uAC00 \uBBF8\uC18C \uB4A4\uB85C
      \uC228\uC5C8\uB2E4."
    _lines:
    - "\uADF8\uB140\uC758 \uB9C8\uC74C \uC18D \uC2EC\uC5F0\uC5D0 \uB4E4\uC5B4\uC654\uB2E4.
      \uBB34\uC5B8\uAC00 \uB4E4\uB9B4 \uB4EF\uD558\uB2E4\uAC00, \uBBF8\uC18C \uB4A4\uB85C
      \uC228\uC5C8\uB2E4."
    - "'\uAD1C\uCC2E\uC544. \uAD1C\uCC2E\uC544. \uAD1C\uCC2E\uC544.'"
    - "\uAC19\uC740 \uB9D0\uB9CC \uB418\uD480\uC774\uD574\uC11C \uB4E4\uB838\uB2E4.
      \uADF8 \uB108\uBA38\uB294 \uB2EB\uD600 \uC788\uC5C8\uB2E4."
    - "\"\uB355\uBD84\uC5D0 \uC880 \uD3B8\uD574\uC84C\uC5B4\uC694. \uAC10\uC0AC\uD569\uB2C8\uB2E4!\"
      \uC9C0\uC218\uAC00 \uC6C3\uC73C\uBA70 \uC778\uC0AC\uD588\uB2E4."
    - "\uC5D8\uB9AC\uBCA0\uC774\uD130 \uAC70\uC6B8 \uC55E\uC5D0\uC11C \uC5F0\uC2B5\uD55C
      \uADF8 \uBBF8\uC18C\uB77C\uB294 \uAC78, \uB098\uB9CC \uC54C\uC558\uB2E4."
    _afterLine: "\"\uB355\uBD84\uC5D0 \uAD1C\uCC2E\uC544\uC84C\uC5B4\uC694!\" (\uC5F0\uC2B5\uD55C
      \uBBF8\uC18C\uB2E4.)"
  - _id: leave
    _title: "\uC5D4\uB529 \xB7 \uC774\uC0C1 \uC5C6\uC74C"
    _situation: "\uC9C0\uC218\uAC00 \uC2DC\uACC4\uB97C \uBD24\uB2E4."
    _lines:
    - "\uC9C0\uC218\uAC00 \uC2DC\uACC4\uB97C \uBD24\uB2E4. \"\uC544, \uD68C\uC758\uAC00
      \uC788\uC5B4\uC11C\uC694. \uC624\uB298 \uAC10\uC0AC\uD588\uC2B5\uB2C8\uB2E4!\""
    - "\uADF8\uB140\uB294 \uB05D\uAE4C\uC9C0 \uC6C3\uC73C\uBA70 \uB098\uAC14\uB2E4."
    - "\uD68C\uC0AC\uB85C \uBCF4\uB0B8 \uC0C1\uB2F4 \uAE30\uB85D\uC5D0\uB294 \uD55C
      \uC904\uB9CC \uB0A8\uC558\uB2E4. '\uC0C1\uB2F4 \uACB0\uACFC: \uC774\uC0C1 \uC5C6\uC74C.'"
    _afterLine: "\uBE48 \uC18C\uD30C\uB2E4. \uBA85\uD568 \uD55C \uC7A5\uC774 \uB0A8\uC544
      \uC788\uB2E4."
  - _id: expose
    _title: "\uC5D4\uB529 \xB7 \uB4E4\uCF30\uB2E4"
    _situation: "\uC9C0\uC218\uC758 \uC5BC\uAD74\uC5D0\uC11C \uD54F\uAE30\uAC00 \uAC00\uC168\uB2E4."
    _lines:
    - "\"\u2026\uADF8\uAC78 \uC5B4\uB5BB\uAC8C \uC544\uC138\uC694.\" \uC9C0\uC218\uC758
      \uC5BC\uAD74\uC5D0\uC11C \uD54F\uAE30\uAC00 \uAC00\uC168\uB2E4."
    - "\"\uD68C\uC0AC\uC5D4 \uB9D0\uD558\uC9C0 \uB9C8\uC138\uC694. \uC81C\uBC1C\uC694.
      \uADF8\uB7FC \uC800 \uC9C4\uC9DC \uB05D\uB098\uC694.\""
    - "\uADF8\uB140\uB294 \uB0B4 \uB300\uB2F5\uB3C4 \uB4E3\uC9C0 \uC54A\uACE0 \uB098\uAC14\uB2E4."
    - "\uB2E4\uC74C \uB0A0, \uD68C\uC0AC\uC5D0\uC11C \uC5F0\uB77D\uC774 \uC654\uB2E4.
      \uC9C0\uC218\uC758 \uC0C1\uB2F4 \uC2E0\uCCAD\uC774 \uCDE8\uC18C\uB410\uB2E4\uACE0."
    _afterLine: "\u2026"
  _truthTrust: 3
  _keyFragment: {fileID: 2092412453}
  _leaveTrust: -2
