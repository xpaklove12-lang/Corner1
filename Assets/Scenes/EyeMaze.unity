--- !u!114 &445146097
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 445146094}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 312895117fcef984e8733069c83ca936, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EyeMaze.FieldNPC
  _displayName: "\uC740\uC7AC \uC5B4\uBA38\uB2C8"
  _interactRange: 0.6
  _radius: 0.26
  _blocks: 0
  _height: 1.05
  _bodyColor: {r: 1, g: 1, b: 1, a: 1}
  _lineBefore: "\uC18C\uD30C \uB05D\uC5D0 \uC549\uC544 \uAC00\uBC29\uB048\uC744 \uAF2D
    \uC950\uACE0 \uC788\uB2E4."
  _lineAfterResolved: "\"\u2026\uACE0\uB9C8\uC6CC\uC694. \uC624\uB298\uC740 \uC870\uAE08
    \uB9D0\uD558\uACE0 \uC2F6\uC5B4\uC84C\uC5B4\uC694.\""
  _met: 0
  _resolved: 0
  _talkCsv: {fileID: 4900000, guid: cde56ac62c9d4e898f79edc8882a916f, type: 3}
  _dialogueActorId: EunjaeMom
  _portrait: {fileID: -3604548235104814106, guid: 76af8779ced393f4fb322bcc8c7d0251, type: 3}
  _talkOnly: 1
  _talkLines:
  - "\uC548\uB155\uD558\uC138\uC694, \uC120\uC0DD\uB2D8. \uC0C1\uB2F4 \uC2DC\uAC04
    \uC804\uC778\uB370 \uBC88\uAC70\uB86D\uAC8C \uC8C4\uC1A1\uD574\uC694."
  - "\uC624\uB298 \uCCAB \uC0C1\uB2F4\uC73C\uB85C \uC608\uC57D\uD55C \uC740\uC7AC
    \uB9D0\uC778\uB370\uC694... \uC0C1\uB2F4\uC744 \uC2E0\uCCAD\uD55C \uAC8C \uC800\uC608\uC694."
  - "\uBBF8\uB9AC \uC124\uBA85\uB4DC\uB9B4 \uAC8C \uC788\uC5B4\uC11C \uC608\uC57D
    \uC2DC\uAC04\uBCF4\uB2E4 \uC77C\uCC0D \uCC3E\uC544\uBD48\uC5C8\uC5B4\uC694."
  - "\uC6B0\uB9AC \uC740\uC7AC\uAC00... \uC138 \uB2EC\uC9F8 \uC544\uBB34\uB9D0\uB3C4
    \uD558\uC9C0 \uC54A\uACE0 \uC788\uC5B4\uC694. \uB2E8 \uD55C\uB9C8\uB514\uB3C4\uC694."
  - "\uC138 \uB2EC \uC804\uC5D0 \uCF69\uCFE0\uB974 \uACB0\uC120\uC774 \uC788\uC5C8\uC5B4\uC694.
    \uADF8\uB9AC\uACE0 \uADF8\uB0A0 \uC740\uC7AC \uC544\uBE60\uAC00 \uACF5\uC5F0\uC7A5
    \uB85C\uBE44\uC5D0\uC11C \uC4F0\uB7EC\uC84C\uC5B4\uC694."
  - "\uC4F0\uB7EC\uC9C0\uAE30 \uC804 \uC740\uC7AC\uC5D0\uAC8C \uC804\uD654\uB97C
    \uD588\uB098\uBD10\uC694. \uC740\uC7AC\uB294 \uBB34\uB300 \uC704\uB77C \uC804\uD654\uB97C
    \uBABB \uBC1B\uC558\uB300\uC694."
  - "...\uADF8\uAC8C \uADF8\uC774\uAC00 \uC0B4\uBA74\uC11C \uD55C \uB9C8\uC9C0\uB9C9
    \uC804\uD654\uC600\uC5B4\uC694."
  - "\uADF8 \uB0A0 \uC774\uD6C4 \uD53C\uC544\uB178\uB294 \uAC70\uB4E4\uB5A0\uBCF4\uC9C0\uB3C4
    \uC54A\uACE0, \uD734\uB300\uC804\uD654\uB3C4 \uB298 \uB4A4\uC9D1\uC5B4 \uB193\uC544\uC694."
  - "\uC774\uBBF8 \uC5EC\uB7EC \uC0C1\uB2F4\uC18C\uB97C \uCC3E\uC544\uAC00\uBCF4\uC558\uC9C0\uB9CC
    \uC740\uC7AC\uB294 \uD55C\uBC88\uB3C4 \uC785\uC744 \uC5F4\uC9C0 \uC54A\uC558\uC5B4\uC694.
    \uC120\uC0DD\uB2D8\uC740 \uB2E4\uB974\uB2E4\uACE0 \uD574\uC11C\u2026 \uADF8\uB798\uC11C
    \uCC3E\uC544\uC654\uC5B4\uC694."
  - "\uAF2D \uC880 \uBD80\uD0C1\uB4DC\uB9B4\uAC8C\uC694. \uBB34\uC2A8 \uB9D0\uC774\uB77C\uB3C4
    \uC88B\uC73C\uB2C8 \uC740\uC7AC\uC640 \uB2E4\uC2DC \uC774\uC57C\uAE30\uD558\uAC8C
    \uD574\uC8FC\uC138\uC694."
  _lineAfterTalk: "\"\uBC16\uC5D0\uC11C \uAE30\uB2E4\uB9B4\uAC8C\uC694.\""
  _leavesAfterTalk: 1
  _revealAfterTalk: {fileID: 2118138529}
  _revealLine: 
  _appearsLater: 0
  _walkSpeed: 2.6
  _standHeight: 1.6
  _floorY: -3
  _seatPoint: {fileID: 0}
  _body: {fileID: 445146096}
  _inner: {fileID: 275511733}
  _marker: {fileID: 598410127}
