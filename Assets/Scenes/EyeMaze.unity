  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EyeMaze.DialogueNode
  _situation: "\"\uC9D1\uC5D0\uB3C4 \uBCC4\uC77C \uC5C6\uC5B4\uC694. \uC5C4\uB9C8\uB3C4
    \uC798 \uC9C0\uB0B4\uC2DC\uACE0\uC694.\""
  _options:
  - _text: "\uB2E4\uD589\uC774\uC5D0\uC694. \uC88B\uC740 \uAC00\uC871\uC774\uB124\uC694."
    _response: "\"\uB124, \uADF8\uB7FC\uC694.\" \uB208\uC774 \uD734\uB300\uD3F0 \uCABD\uC73C\uB85C
      \uAC14\uB2E4."
    _requires: {fileID: 0}
    _requiresClue: {fileID: 0}
    _trust: -1
    _dilation: 0
    _advance: 0
    _ending: 
  - _text: "\uC9C0\uC218 \uC528\uAC00 \uBC84\uD2F0\uB294 \uAC8C\u2026 \uC9C0\uC218
      \uC528 \uD63C\uC790\uB9CC\uC744 \uC704\uD55C \uAC74 \uC544\uB2CC \uAC83 \uAC19\uC544\uC694."
    _response: "\uC9C0\uC218\uC758 \uC190\uC774 \uBB34\uB98E \uC704\uC5D0\uC11C \uAF49
      \uC950\uC5B4\uC84C\uB2E4. \"\u2026\uC5C4\uB9C8\uAC00 \uC544\uD504\uC138\uC694.\"
      \uCC98\uC74C\uC73C\uB85C \uC6C3\uC9C0 \uC54A\uACE0 \uD55C \uB9D0\uC774\uC5C8\uB2E4."
    _requires: {fileID: 1500823412}
    _requiresClue: {fileID: 0}
    _trust: 2
    _dilation: 0.25
    _advance: 0
    _ending: 
  - _text: "\uC9C0\uB09C\uC8FC \uADF8 \uC77C\u2026 \uD68C\uC0AC\uC5D0\uB3C4 \uC81C\uB300\uB85C
      \uC54C\uB9AC\uB294 \uAC8C \uC88B\uC9C0 \uC54A\uC744\uAE4C\uC694?"
    _response: 
    _requires: {fileID: 2092412453}
