  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7e8e615d90239a74ebc22825cd350437, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EyeMaze.DialogueNode
  _situation: "\uC9C0\uC218\uAC00 \uC6C3\uC73C\uBA70 \uB9D0\uD55C\uB2E4. \"\uAD1C\uCC2E\uC544\uC694,
    \uADF8\uB0E5 \uC694\uC998 \uC880 \uD53C\uACE4\uD574\uC11C\uC694. \uD68C\uC0AC\uC5D0\uC11C
    \uD55C\uBC88 \uBC1B\uC544 \uBCF4\uB77C\uAE38\uB798.\""
  _options:
  - _text: "\uD53C\uACE4\uD558\uBA74 \uD479 \uC26C\uC154\uC57C\uC8E0. \uC624\uB298\uC740
      \uC77C\uCC0D \uB4E4\uC5B4\uAC00\uC138\uC694."
    _response: "\"\uB124, \uADF8\uB7F4\uAC8C\uC694!\" \uB300\uB2F5\uC774 \uB108\uBB34
      \uBE68\uB790\uB2E4."
    _requires: {fileID: 0}
    _requiresClue: {fileID: 0}
    _trust: -1
    _dilation: 0
    _advance: 0
    _ending: 
  - _text: "\uAD1C\uCC2E\uB2E4\uB294 \uB9D0\uC774 \uCC38 \uBE68\uB9AC \uB098\uC624\uC2DC\uB124\uC694.
      \uBC24\uB2A6\uAC8C\uAE4C\uC9C0\uB3C4 \uADF8\uB807\uAC8C \uB9D0\uC500\uD558\uC168\uC744
      \uAC83 \uAC19\uC544\uC694."
    _response: "\uBBF8\uC18C\uAC00 \uADF8\uB300\uB85C \uAD73\uC5C8\uB2E4. \"\u2026\uADF8\uAC78
      \uC5B4\uB5BB\uAC8C.\""
    _requires: {fileID: 887896108}
    _requiresClue: {fileID: 0}
    _trust: 1
    _dilation: 0.15
    _advance: 1
    _ending: 
  - _text: "\uC6C3\uB294 \uC5BC\uAD74\uC774\u2026 \uC870\uAE08 \uBB34\uAC70\uC6CC
      \uBCF4\uC5EC\uC694. \uB9E4\uC77C \uC544\uCE68 \uADF8 \uC5BC\uAD74\uC744 \uC900\uBE44\uD558\uC2DC\uB294
      \uAC83 \uAC19\uACE0\uC694."
    _response: "\uC9C0\uC218\uAC00 \uC785\uAF2C\uB9AC\uB97C \uB0B4\uB838\uB2E4\uAC00,
      \uAE09\uD788 \uB2E4\uC2DC \uC62C\uB838\uB2E4."
    _requires: {fileID: 1140141019}
    _requiresClue: {fileID: 0}
    _trust: 1
    _dilation: 0.1
    _advance: 0
    _ending: 
