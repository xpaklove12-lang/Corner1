  m_Script: {fileID: 11500000, guid: 7e8e615d90239a74ebc22825cd350437, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EyeMaze.DialogueNode
  _situation: "\uC740\uC7AC\uAC00 \uD0C1\uC790 \uC704 \uD734\uB300\uD3F0\uC744 \uB9CC\uC9C0\uC791\uAC70\uB9B0\uB2E4.
    \uD654\uBA74\uC740 \uC5EC\uC804\uD788 \uC544\uB798\uB97C \uD5A5\uD574 \uC788\uB2E4."
  _options:
  - _text: "\uD734\uB300\uD3F0\uC740 \uC7A0\uAE50 \uB123\uC5B4 \uB458\uAE4C\uC694?"
    _response: "\uC190\uC774 \uAD73\uC5C8\uB2E4. \uD734\uB300\uD3F0\uC744 \uB354
      \uAF49 \uC950\uC5C8\uB2E4."
    _requires: {fileID: 0}
    _requiresClue: {fileID: 0}
    _trust: -1
    _dilation: 0
    _advance: 0
    _ending: 
  - _text: "\uB4A4\uC9D1\uC5B4 \uB450\uC2E0 \uAC74, \uBCF4\uACE0 \uC2F6\uC9C0 \uC54A\uC740
      \uAC8C \uC788\uC5B4\uC11C\uACA0\uC8E0. \uADF8\uB807\uB2E4\uACE0 \uC9C0\uC6B0\uC9C0\uB3C4
      \uBABB\uD558\uACE0\uC694."
    _response: "\uC228\uC774 \uBA4E\uC740 \uAC83 \uAC19\uC558\uB2E4. \uC544\uC8FC
      \uC791\uAC8C, \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4."
    _requires: {fileID: 435395900}
    _requiresClue: {fileID: 0}
    _trust: 1
    _dilation: 0.2
    _advance: 1
    _ending: 
  - _text: "\uADF8 \uC545\uBCF4\u2026 \uC740\uC7AC \uC528 \uC5F0\uC8FC\uB97C \uC815\uB9D0
      \uAE30\uB2E4\uB9B0 \uC0AC\uB78C\uC774 \uC788\uC5C8\uB098 \uBD10\uC694."
    _response: "\uB208\uC774 \uD754\uB4E4\uB838\uB2E4. \uC190\uAC00\uB77D\uC774 \uADF8
      \uACE1\uC758 \uCCAB \uC74C\uC744 \uC9DA\uC5C8\uB2E4."
    _requires: {fileID: 0}
    _requiresClue: {fileID: 995711289}
    _trust: 1
    _dilation: 0.1
    _advance: 0
    _ending: 
