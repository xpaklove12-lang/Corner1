  m_Script: {fileID: 11500000, guid: 7e8e615d90239a74ebc22825cd350437, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EyeMaze.DialogueNode
  _situation: "\uC740\uC7AC\uC758 \uB208\uAC00\uAC00 \uBD89\uB2E4. \uBB34\uC5B8\uAC00
    \uB9D0\uD558\uB824\uB2E4 \uBA48\uCD98\uB2E4."
  _options:
  - _text: "\uC790\uCC45\uD558\uC9C0 \uB9C8\uC138\uC694. \uBB34\uB300 \uC704\uC600\uC796\uC544\uC694.
      \uBABB \uBC1B\uC740 \uAC74 \uC5B4\uCA54 \uC218 \uC5C6\uC5C8\uC5B4\uC694."
    _response: "\uC740\uC7AC\uAC00 \uACE0\uAC1C\uB97C \uB3CC\uB838\uB2E4. '\uBABB
      \uBC1B\uC740 \uAC8C' \uC544\uB2C8\uB77C\uB294 \uB4EF\uC774."
    _requires: {fileID: 0}
    _requiresClue: {fileID: 0}
    _trust: -1
    _dilation: 0
    _advance: 0
    _ending: 
  - _text: "\uADF8\uB0A0 \uC77C, \uB2E4\uB4E4 \uC544\uB294 \uC774\uC57C\uAE30\uB791
      \uC740\uC7AC \uC528\uAC00 \uAE30\uC5B5\uD558\uB294 \uAC8C\u2026 \uC870\uAE08
      \uB2E4\uB974\uC8E0?"
    _response: "\uC740\uC7AC\uC758 \uC190\uC774 \uB5A8\uB838\uB2E4. \uC544\uBB34\uB3C4
      \uBAB0\uB790\uB358 \uAC78, \uB0B4\uAC00 \uC54C\uACE0 \uC788\uB2E4."
    _requires: {fileID: 103944951}
    _requiresClue: {fileID: 0}
    _trust: 2
    _dilation: 0.25
    _advance: 0
    _ending: 
  - _text: "\uB4E4\uC5B4 \uBCF4\uBA74 \uD3B8\uD574\uC9C8 \uAC70\uC608\uC694. \uC9C0\uAE08
      \uAC19\uC774 \uB4E4\uC5B4 \uBD10\uC694."
    _response: 
    _requires: {fileID: 2051122685}
    _requiresClue: {fileID: 0}
    _trust: 0
    _dilation: 0
    _advance: 0
    _ending: delete
