  m_Script: {fileID: 11500000, guid: 312895117fcef984e8733069c83ca936, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EyeMaze.FieldNPC
  _displayName: "\uC740\uC7AC \uC5B4\uBA38\uB2C8"
  _interactRange: 0.6
  _radius: 0.26
  _blocks: 0
  _height: 1.05
  _bodyColor: {r: 1, g: 1, b: 1, a: 1}
  _lineBefore: "\uC18C\uD30C \uB05D\uC5D0 \uC549\uC544 \uAC00\uBC29\uB048\uC744 \uAF2D
    \uC950\uACE0 \uC788\uB2E4."
  _lineAfterResolved: "\"\u2026\uACE0\uB9C8\uC6CC\uC694. \uC624\uB298\uC740 \uC870\uAE08
    \uB9D0\uD558\uACE0 \uC2F6\uC5B4\uC84C\uC5B4\uC694.\""
  _met: 0
  _resolved: 0
  _portrait: {fileID: -3604548235104814106, guid: 76af8779ced393f4fb322bcc8c7d0251, type: 3}
  _talkOnly: 1
  _talkLines:
  - "\uC120\uC0DD\uB2D8, \uC640 \uC8FC\uC154\uC11C \uAC10\uC0AC\uD574\uC694. \uC0C1\uB2F4
    \uC2E0\uCCAD\uD55C \uC0AC\uB78C\uC774 \uC800\uC608\uC694."
  - "\uC6B0\uB9AC \uC740\uC7AC\uAC00\u2026 \uC11D \uB2EC\uC9F8 \uC785\uC744 \uC5F4\uC9C0
    \uC54A\uC544\uC694. \uD55C\uB9C8\uB514\uB3C4\uC694."
  - "\uC11D \uB2EC \uC804\uC5D0 \uCF69\uCFE0\uB974 \uACB0\uC120\uC774 \uC788\uC5C8\uC5B4\uC694.
    \uADF8\uB0A0 \uC560 \uC544\uBE60\uAC00 \uACF5\uC5F0\uC7A5 \uB85C\uBE44\uC5D0\uC11C
    \uC4F0\uB7EC\uC84C\uC5B4\uC694."
  - "\uC740\uC7AC\uB294 \uBB34\uB300 \uC704\uB77C \uC804\uD654\uB97C \uBABB \uBC1B\uC558\uB300\uC694.
    \uADF8\uAC8C\u2026 \uB9C8\uC9C0\uB9C9 \uC804\uD654\uC600\uC5B4\uC694."
  - "\uADF8 \uB4A4\uB85C \uD53C\uC544\uB178 \uB69C\uAED1\uB3C4 \uC548 \uC5F4\uACE0,
    \uD734\uB300\uD3F0\uC740 \uB298 \uB4A4\uC9D1\uC5B4 \uB194\uC694."
  - "\uC81C\uAC00 \uBB34\uC2A8 \uB9D0\uC744 \uD574\uB3C4 \uC548 \uB3FC\uC694. \uC120\uC0DD\uB2D8\uC740
    \uB2E4\uB974\uB2E4\uACE0 \uD574\uC11C\u2026 \uCC3E\uC544\uC654\uC5B4\uC694."
  - "\uBC16\uC5D0\uC11C \uAE30\uB2E4\uB9B4\uAC8C\uC694. \uC740\uC7AC \uB4E4\uC5EC\uBCF4\uB0BC\uAC8C\uC694."
  _lineAfterTalk: "\"\uBC16\uC5D0\uC11C \uAE30\uB2E4\uB9B4\uAC8C\uC694.\""
  _leavesAfterTalk: 1
  _revealAfterTalk: {fileID: 2118138529}
  _revealLine: "\uC740\uC7AC\uB294 \uB098\uB97C \uD55C \uBC88 \uBCF4\uB354\uB2C8,
    \uB9D0\uC5C6\uC774 \uCC3D\uBC16\uC73C\uB85C \uC2DC\uC120\uC744 \uB3CC\uB838\uB2E4."
  _appearsLater: 0
  _walkSpeed: 2.6
  _standHeight: 1.6
  _floorY: -3
  _body: {fileID: 445146096}
  _inner: {fileID: 275511733}
  _marker: {fileID: 598410127}
