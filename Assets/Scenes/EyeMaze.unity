  _alreadyMaxMessage: "\uB354\uB294 \uBC00\uC5B4\uBD99\uC77C \uC218 \uC5C6\uB2E4."
  _nothingHiddenMessage: "\uC774 \uCE35\uC5D0\uB294 \uC228\uAE34 \uAC83\uC774 \uC5C6\uB2E4."
  _hopeBrokenMessage: "\uD76C\uB9DD\uC774 \uAEBE\uC600\uB2E4. \uC740\uC7AC\uAC00
    \uB2E4\uC2DC \uACBD\uACC4\uD55C\uB2E4."
  _stateMessages:
  - "\uD3C9\uC628 \xB7 \uC7A5\uC560\uBB3C\uC774 \uB290\uB824\uC9C4\uB2E4."
  - "\uACBD\uACC4 \xB7 \uC7A5\uC560\uBB3C\uC774 \uAE30\uC5B5\uC744 \uC9C0\uD0A4\uB7EC
    \uBAA8\uC778\uB2E4."
  - "\uBC18\uAC10 \xB7 \uC228\uAE34 \uAE30\uC5B5\uC774 \uB4DC\uB7EC\uB09C\uB2E4."
  - "\uB3D9\uC694 \xB7 \uBC84\uD2F0\uBA74 \uAC00\uAE4C\uC6B4 \uBCBD\uC774 \uD754\uB4E4\uB824
    \uBB34\uB108\uC9C4\uB2E4."
  - "\uACA9\uB3D9 \xB7 \uBCBD\uC774 \uB354 \uBE68\uB9AC, \uB354 \uBA40\uB9AC \uBB34\uB108\uC9C4\uB2E4."
