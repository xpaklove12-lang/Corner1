#!/bin/sh
# 커밋 제목 괄호가 요구사항 ID 형식인지 검사(Tools/check-specs.ps1). 처음 한 번 git config core.hooksPath .githooks 로 켠다.
root=$(git rev-parse --show-toplevel)
if command -v pwsh >/dev/null 2>&1; then ps=pwsh; else ps=powershell.exe; fi
exec "$ps" -NoProfile -ExecutionPolicy Bypass -File "$root/Tools/check-specs.ps1" -CommitMessageFile "$1"
